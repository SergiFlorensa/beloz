PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://user:password@host:5432/database
# Production: generate a random secret of at least 32 bytes. Never commit its value.
# JWT_SECRET=
# Native Android does not require an Origin allowlist. List exact origins for web clients.
CORS_ORIGINS=
# Render is detected automatically. Set this only if the proxy topology differs.
# TRUST_PROXY_HOPS=1

# Fast deterministic chat. Keep this default for production/free Render.
AI_RESPONSE_MODE=fast

# Local Ollama fallback.
# AI_PROVIDER=ollama
# AI_RESPONSE_MODE=ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=gemma3:1b
# OLLAMA_TIMEOUT_MS=2500
# Optional ranking only; model-generated facts are never displayed.
